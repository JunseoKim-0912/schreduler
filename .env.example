# Schreduler 환경변수 예시
# 이 파일을 .env로 복사한 뒤 값을 채운다:  cp .env.example .env
# .env는 커밋하지 않는다 (.gitignore). 비밀값은 여기가 아니라 .env에만 적는다.
# 값을 비워 두면 "설정 안 됨"으로 처리된다.

# ---------------------------------------------------------------------------
# 앱
# ---------------------------------------------------------------------------

# 실행 환경 이름 (development / production 등)
ENVIRONMENT=development

# 앱 로그 레벨 (DEBUG / INFO / WARNING / ERROR). LLM 토큰 사용량, 알림 발송, 포인트 계산 로그는 INFO.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 데이터베이스
# ---------------------------------------------------------------------------

# SQLAlchemy DB URL. 앱과 Alembic 마이그레이션이 함께 쓴다.
# - SQLite(개발, 기본값): sqlite:///./schreduler.db
# - PostgreSQL:          postgresql+psycopg://schreduler:schreduler@localhost:5432/schreduler
# - Railway(Volume /data): sqlite:////data/schreduler.db  (docs/deploy_railway.md)
DATABASE_URL=sqlite:///./schreduler.db

# ---------------------------------------------------------------------------
# LLM (일정 어시스턴트, 페르소나 대화, 미준수 피드백, 저녁 체크인 대화)
# ---------------------------------------------------------------------------

# [비밀] LLM API 키. 비어 있으면 LLM을 쓰는 엔드포인트가 500을 돌려준다.
LLM_API_KEY=

# 사용할 모델 이름. 이 줄을 지우거나 주석 처리하면 코드 기본값(gpt-5.6-luna)을 쓴다 (빈 값으로 두면 안 된다).
LLM_MODEL=gpt-5.6-luna

# 일정 어시스턴트(자연어 일정 에이전트, Responses API)에 쓸 모델. 비워 두면 gpt-5.6-luna (LLM_MODEL과 상관없음).
# 페르소나 대화·저녁 체크인·미준수 피드백은 이 값과 상관없이 LLM_MODEL을 쓴다.
ASSISTANT_MODEL=

# 일정 어시스턴트의 추론 강도 (reasoning.effort). 앱 시작 때 모델별 허용 값으로 검증한다 — none/minimal은 모델에 맞게
# 서로 바꿔 주고(gpt-5-nano는 minimal, gpt-5.x는 none), 지원하지 않는 값이면 시작이 실패한다.
ASSISTANT_REASONING_EFFORT=medium

# 하루 LLM 비용 한도 (USD). 하루는 APP_TIMEZONE 자정에 바뀐다. LLM을 부르기 직전마다 오늘 합계를 확인해서
# 한도 이상이면 호출하지 않고 429를 돌려준다. LLM이 필요 없는 기능(일정·할 일·완료·버튼 확정/취소·되돌리기·
# 버튼만 누르는 미준수 사유·알림)은 한도와 상관없이 동작한다. 비용은 app/services/llm_pricing.py의 가격표로 계산하고,
# LLM_MODEL·ASSISTANT_MODEL이 가격표에 없으면 앱 시작이 실패한다.
# 사용자 한 명의 하루 한도
LLM_DAILY_BUDGET_PER_USER_USD=1.00
# 모든 사용자(+개발 스크립트)를 합친 하루 한도
LLM_DAILY_BUDGET_TOTAL_USD=5.00
# 관리자(users.is_admin) 한도. 비워 두면 관리자도 LLM_DAILY_BUDGET_PER_USER_USD를 쓴다.
LLM_DAILY_BUDGET_ADMIN_USD=

# ---------------------------------------------------------------------------
# 데모 모드 (로그인 화면의 [Try the demo] 버튼, POST /auth/demo)
# ---------------------------------------------------------------------------

# 켜면 누구나 이메일·비밀번호 없이 임시 데모 계정(예시 대학생 일주일 포함)으로 바로 들어온다. 데모 계정과 그 데이터는
# 24시간 뒤 매시간 도는 정리 작업이 지운다. 꺼 두면(기본) POST /auth/demo는 404이고 버튼도 안 보인다.
# SIGNUP_MODE와는 상관없다 — 가입을 닫아 둔 채(closed) 데모만 열 수 있다.
DEMO_MODE_ENABLED=false
# 최근 1시간 동안 만들 수 있는 데모 계정 수 (전체 합계. 프록시 뒤라 IP 기준 제한은 쓰지 않는다)
DEMO_MAX_CREATIONS_PER_HOUR=30
# 데모 계정 한 명의 하루 LLM 한도 (USD)
DEMO_LLM_BUDGET_PER_USER_USD=0.05
# 모든 데모 계정을 합친 하루 LLM 한도 (USD). LLM_DAILY_BUDGET_TOTAL_USD와 따로 센다 — 데모가 다 써도 일반 계정은 막히지 않는다.
DEMO_LLM_BUDGET_TOTAL_USD=2.00

# ---------------------------------------------------------------------------
# 시간
# ---------------------------------------------------------------------------

# 날짜·시각 해석 기준 시간대 (IANA 이름). '오늘', 요일 계산과 어시스턴트 프롬프트의 현재 시각에 쓴다.
APP_TIMEZONE=America/Toronto

# ---------------------------------------------------------------------------
# 로그인 · 회원가입
# ---------------------------------------------------------------------------

# 회원가입 방식: closed(가입 불가) / invite(초대 코드 필요, 기본) / open(누구나)
SIGNUP_MODE=invite

# [비밀] SIGNUP_MODE=invite일 때 가입 화면에 넣어야 하는 코드. 비어 있으면 아무도 가입할 수 없다.
INVITE_CODE=

# 세션 쿠키에 Secure 플래그를 붙여 HTTPS로만 보낸다. 배포(HTTPS)에서는 true, 로컬(http://localhost)에서는 false.
SESSION_COOKIE_SECURE=false

# POST/PUT/DELETE를 받아 줄 출처(Origin), 쉼표로 구분. 비우면 요청의 Host와 같은 출처만 받는다 (CSRF 방지).
# 프록시 뒤에서 Host가 바뀌면 실제 주소를 적는다. 예: https://schreduler.example.com
ALLOWED_ORIGINS=

# 프록시(Railway) 뒤에서 X-Forwarded-For / X-Real-IP를 실제 클라이언트 IP로 믿을지. 끄면(기본) 로그인 실패 제한은
# 이메일 기준만 적용한다 — 프록시 뒤에서는 모든 요청이 같은 IP라 IP로 세면 한 사람이 모두를 막을 수 있다.
# 켜기 전에 docs/deploy_railway.md 2절의 확인 방법을 따른다.
TRUST_PROXY_HEADERS=false

# uvicorn이 X-Forwarded-Proto(https)를 믿을 프록시 주소. 로컬 기본 127.0.0.1, Railway에서는 *
# FORWARDED_ALLOW_IPS=127.0.0.1

# 기존 사용자에게 이메일·비밀번호를 붙이고 관리자로 만들기 (비밀번호는 터미널에서 입력):
#   python -m app.scripts.create_admin --email you@example.com
# 비밀번호 재설정:
#   python -m app.scripts.create_admin --email you@example.com --reset

# ---------------------------------------------------------------------------
# 스케줄러 · 백업
# ---------------------------------------------------------------------------

# 알림·저녁 체크인·자정 포인트·DB 백업을 이 프로세스에서 돌린다. 켜진 프로세스는 반드시 하나 (레플리카 1개).
RUN_SCHEDULER=true

# 매일 04:30(APP_TIMEZONE) SQLite 백업을 둘 폴더. 비우면 DB 파일 옆의 backups/ (최근 14개 보관).
# BACKUP_DIR=

# ---------------------------------------------------------------------------
# 알림
# ---------------------------------------------------------------------------

# Firebase 서비스 계정 JSON 파일 경로 (FCM 푸시 발송). 비어 있으면 푸시는 로그만 남기고 건너뛴다.
# 파일 자체는 비밀이므로 저장소 밖이나 gitignore된 secrets/ 폴더에 둔다. 예: secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=

# [비밀] 같은 서비스 계정 JSON의 내용 전체 (파일을 이미지에 넣지 않으려고 배포에서 쓴다). 있으면 위 경로보다 우선.
FIREBASE_CREDENTIALS_JSON=

# [비밀] 텔레그램 봇 토큰 (BotFather 발급, 장기 무응답 에스컬레이션용). 비어 있으면 로그만 남긴다.
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Docker 전용 (docker compose가 읽는다. 로컬 실행에는 필요 없다)
# ---------------------------------------------------------------------------

# 컨테이너 안에서 쓸 DB URL. 비우면 볼륨의 SQLite(sqlite:////app/data/schreduler.db)를 쓴다.
# 위의 DATABASE_URL은 로컬용이라 컨테이너에는 전달되지 않는다.
# DOCKER_DATABASE_URL=

# 컨테이너 안의 Firebase 서비스 계정 JSON 경로 (파일을 컨테이너에 마운트한 경우)
# DOCKER_FIREBASE_CREDENTIALS_PATH=

# 호스트에 노출할 API 포트
# API_PORT=8000

# docker-compose.postgres.yml을 쓸 때의 PostgreSQL 계정·DB 이름 (기본값은 개발용이니 운영에서는 바꾼다)
# POSTGRES_USER=schreduler
# POSTGRES_PASSWORD=
# POSTGRES_DB=schreduler
