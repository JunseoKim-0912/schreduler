# Schreduler 환경변수 예시
# 이 파일을 .env로 복사한 뒤 값을 채운다:  cp .env.example .env
# .env는 커밋하지 않는다 (.gitignore). 비밀값은 여기가 아니라 .env에만 적는다.
# 값을 비워 두면 "설정 안 됨"으로 처리된다.

# ---------------------------------------------------------------------------
# 앱
# ---------------------------------------------------------------------------

# 실행 환경 이름 (development / production 등)
ENVIRONMENT=development

# 앱 로그 레벨 (DEBUG / INFO / WARNING / ERROR). LLM 토큰 사용량, 알림 발송, 포인트 계산 로그는 INFO.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 데이터베이스
# ---------------------------------------------------------------------------

# SQLAlchemy DB URL. 앱과 Alembic 마이그레이션이 함께 쓴다.
# - SQLite(개발, 기본값): sqlite:///./schreduler.db
# - PostgreSQL:          postgresql+psycopg://schreduler:schreduler@localhost:5432/schreduler
DATABASE_URL=sqlite:///./schreduler.db

# ---------------------------------------------------------------------------
# LLM (자연어 일정 추가, 미준수 피드백, 저녁 체크인 대화)
# ---------------------------------------------------------------------------

# [비밀] LLM API 키. 비어 있으면 LLM을 쓰는 엔드포인트가 500을 돌려준다.
LLM_API_KEY=

# 사용할 모델 이름. 이 줄을 지우거나 주석 처리하면 코드 기본값(gpt-5.6-luna)을 쓴다 (빈 값으로 두면 안 된다).
LLM_MODEL=gpt-5.6-luna

# ---------------------------------------------------------------------------
# 알림
# ---------------------------------------------------------------------------

# Firebase 서비스 계정 JSON 파일 경로 (FCM 푸시 발송). 비어 있으면 푸시는 로그만 남기고 건너뛴다.
# 파일 자체는 비밀이므로 저장소 밖이나 gitignore된 secrets/ 폴더에 둔다. 예: secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=

# [비밀] 텔레그램 봇 토큰 (BotFather 발급, 장기 무응답 에스컬레이션용). 비어 있으면 로그만 남긴다.
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Docker 전용 (docker compose가 읽는다. 로컬 실행에는 필요 없다)
# ---------------------------------------------------------------------------

# 컨테이너 안에서 쓸 DB URL. 비우면 볼륨의 SQLite(sqlite:////app/data/schreduler.db)를 쓴다.
# 위의 DATABASE_URL은 로컬용이라 컨테이너에는 전달되지 않는다.
# DOCKER_DATABASE_URL=

# 컨테이너 안의 Firebase 서비스 계정 JSON 경로 (파일을 컨테이너에 마운트한 경우)
# DOCKER_FIREBASE_CREDENTIALS_PATH=

# 호스트에 노출할 API 포트
# API_PORT=8000

# docker-compose.postgres.yml을 쓸 때의 PostgreSQL 계정·DB 이름 (기본값은 개발용이니 운영에서는 바꾼다)
# POSTGRES_USER=schreduler
# POSTGRES_PASSWORD=
# POSTGRES_DB=schreduler
